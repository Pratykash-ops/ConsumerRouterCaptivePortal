    width: 270px;
    min-width: 270px;
    height: 100vh;
    background: #090c13;
    border-right: 1px solid var(--cyber-border);
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .sidebar-brand {
    padding: 20px 18px;
    border-bottom: 1px solid var(--cyber-border);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .brand-crest {
    width: 38px;
    height: 38px;
    background: var(--cyber-panel);
    border: 1px solid var(--neon-cyan);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 0 10px var(--neon-cyan-glow);
