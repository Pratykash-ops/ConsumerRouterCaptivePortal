    font-weight: 900;
    color: var(--neon-cyan);
  }
  .brand-title {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--text-main);
  }
  .brand-sub {
    font-size: 9px;
    color: var(--neon-pink);
    letter-spacing: 0.5px;
  }
  .sidebar-operator {
    padding: 12px 18px;
    background: #0c101a;
    border-bottom: 1px solid var(--cyber-border);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .operator-avatar {
    width: 30px;
    height: 30px;
    background: var(--cyber-panel);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--neon-cyan);
    font-size: 13px;
  }
  .operator-name { font-size: 12px; font-weight: 700; color: var(--text-main); }
  .operator-role { font-size: 10px; color: var(--text-muted); display: flex; align-items: center; gap: 4px; }
  .status-dot { width: 6px; height: 6px; background: var(--neon-green); border-radius: 50%; box-shadow: 0 0 6px var(--neon-green); }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 14px 12px;
  }
  .nav-section-title {
    font-size: 9px;
    font-weight: 700;
    color: var(--text-dim);
    letter-spacing: 1px;
    padding: 6px 8px;
  }
  .nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    margin-bottom: 3px;
    color: var(--text-sub);
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
    border-left: 2px solid transparent;
  }
  .nav-link i { font-size: 14px; width: 18px; text-align: center; color: var(--text-muted); transition: color 0.15s; }
  .nav-link:hover {
    background: rgba(0, 240, 255, 0.05);
    color: var(--text-main);
  }
  .nav-link:hover i { color: var(--neon-cyan); }
  .nav-link.active {
    background: rgba(0, 240, 255, 0.1);
    color: var(--neon-cyan);
    border-left-color: var(--neon-cyan);
    box-shadow: inset 0 0 10px rgba(0, 240, 255, 0.05);
  }
  .nav-link.active i { color: var(--neon-cyan); }
  .nav-jp { font-size: 9px; margin-left: auto; color: var(--text-dim); }
  .nav-badge {
    margin-left: auto;
    background: var(--cyber-panel);
    border: 1px solid var(--cyber-border);
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 10px;
    color: var(--text-sub);
  }
  .nav-dot-active {
    width: 6px; height: 6px; background: var(--neon-cyan); border-radius: 50%; margin-left: auto; box-shadow: 0 0 6px var(--neon-cyan);
  }

  .sidebar-footer {
    padding: 14px 16px;
    border-top: 1px solid var(--cyber-border);
    background: #090c13;
  }
  .footer-telemetry {
    font-size: 11px;
    margin-bottom: 10px;
  }

  /* Main Viewport */
  .cyber-main {
    flex: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }
  .cyber-topbar {
    height: 56px;
    padding: 0 24px;
    background: #0a0e16;
    border-bottom: 1px solid var(--cyber-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 9;
  }
  .view-tag {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: var(--text-main);
  }
  .topbar-telemetry {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .telemetry-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--cyber-panel);
    border: 1px solid var(--cyber-border);
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    font-size: 11px;
    color: var(--text-sub);
  }

  .cyber-content-container {
    flex: 1;
    padding: 24px;
    max-width: 1500px;
    width: 100%;
    margin: 0 auto;
  }

  /* Metric Deck */
  .metric-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .cyber-metric-card {
    background: var(--cyber-card);
    border: 1px solid var(--cyber-border);
    border-radius: var(--radius);
    padding: 16px 20px;
    position: relative;
    overflow: hidden;
  }
  .cyber-metric-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, var(--neon-cyan), transparent);
  }
  .metric-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .metric-label { font-size: 10px; font-weight: 700; color: var(--text-muted); }
  .metric-number { font-size: 26px; font-weight: 800; }
  .metric-sub { font-size: 11px; color: var(--text-dim); margin-top: 4px; }

  .overview-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 18px;
  }
  .card-title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--cyber-border);
  }
  .card-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .control-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
  }
  .empty-state {
    padding: 24px;
    text-align: center;
    color: var(--text-muted);
    font-size: 12px;
  }
  .action-bar-form {
    background: var(--cyber-panel);
    border: 1px solid var(--cyber-border);
    border-radius: var(--radius-sm);
    padding: 14px;
  }

  /* Wallpaper Grid */
  .wallpaper-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }
  .wallpaper-card {
    border: 1px solid var(--cyber-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    transition: all 0.2s ease;
    background: var(--cyber-panel);
    display: block;
    position: relative;
  }
  .wallpaper-card img {
    width: 100%;
    height: 100px;
    object-fit: cover;
    display: block;
  }
  .wallpaper-card .card-label {
    padding: 6px 10px;
    font-size: 11px;
    color: var(--text-sub);
    text-align: center;
  }
  .wallpaper-card:hover {
    border-color: var(--neon-cyan);
    box-shadow: 0 0 10px var(--neon-cyan-glow);
  }
  .wallpaper-card.active {
    border-color: var(--neon-pink);
    box-shadow: 0 0 15px var(--neon-pink-glow);
  }

  @media (max-width: 1024px) {
    .metric-grid { grid-template-columns: 1fr 1fr; }
    .overview-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  function selectWp(card) {
    document.querySelectorAll('.wallpaper-card').forEach(c => c.classList.remove('active'));
    card.classList.add('active');
    const radio = card.querySelector('input[type="radio"]');
    if (radio) radio.checked = true;
  }
</script>
